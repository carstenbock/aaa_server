{application, aaa_server,
 [{description, "3GPP AAA Server — VoWiFi / Carrier-Wi-Fi (SWm/SWx/S6b/STa per TS 29.273)"},
  {vsn, "0.1.0"},
  {modules, [aaa_app, aaa_sup, aaa_config,
             aaa_diameter_svc,
             aaa_swm_server, aaa_swx_client, aaa_s6b_server, aaa_sta_server,
             aaa_session_mgr, aaa_eap_relay,
             aaa_eap_codec, aaa_eap_crypto, aaa_nai, aaa_network_name,
             aaa_radius,
             aaa_metrics, aaa_http, aaa_http_handler,
             diameter_gen_swm, diameter_gen_swx,
             diameter_gen_s6b, diameter_gen_sta]},
  {registered, [aaa_sup, aaa_session_mgr, aaa_diameter_svc,
                aaa_swm_server, aaa_swx_client, aaa_s6b_server, aaa_sta_server,
                aaa_metrics]},
  {applications, [kernel, stdlib, sasl, crypto, ssl, diameter, cowboy, jsx]},
  {mod, {aaa_app, []}}]}.
