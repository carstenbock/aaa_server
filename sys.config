[
 %% All AAA Server configuration is read from environment variables.
 %% See aaa_config.erl for the complete list of supported env vars.
 %%
 %% Redis-backed session store (TS 29.273 SWm/SWx/S6b state shared
 %% across all AAA pods so any pod can handle any DER):
 %%   AAA_REDIS_HOST             (default "aaa-redis")
 %%   AAA_REDIS_PORT             (default 6379)
 %%   AAA_REDIS_DB               (default 0)
 %%   AAA_REDIS_PASSWORD         (default "" — no auth)
 %%   AAA_REDIS_POOL_SIZE        (default 8)
 %%   AAA_REDIS_CONNECT_TIMEOUT  (default 5000 ms)
 %%   AAA_REDIS_RECONNECT_SLEEP  (default 500 ms)
 %%   AAA_REDIS_KEY_PREFIX       (default "aaa:")
 {kernel, [
   {logger_level, info},
   {logger, [
     {handler, default, logger_std_h, #{
       config => #{type => standard_io},
       level => info,
       formatter => {logger_formatter, #{
         single_line => true,
         template => [time, " [", level, "] ", msg, "\n"]
       }}
     }}
   ]}
 ]},
 {sasl, [{sasl_error_logger, false}]}
].
